---
// The Rules section - what makes Mingle different
const rules = [
  {
    rule: "You have to be there.",
    detail: "You can only see and match with people at the same venue. No swiping from the couch.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
    </svg>`
  },
  {
    rule: "Matches expire in 24 hours.",
    detail: "If you don't meet, the match disappears. No stale conversations.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>`
  },
  {
    rule: "10 messages. That's it.",
    detail: "Enough to break the ice. Not enough to become pen pals. Go talk to them.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>`
  },
  {
    rule: "No algorithm.",
    detail: "Everyone at the venue is visible. We don't pick who you see. You do.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
    </svg>`
  }
];
---

<section id="rules" class="py-24 bg-[var(--color-dark)]">
  <div class="max-w-3xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-2 bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] rounded-full text-sm font-semibold mb-4 border border-[var(--color-primary)]/30">
        Ground rules
      </span>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
        The rules
      </h2>
      <p class="text-xl text-[var(--color-text-muted)] max-w-2xl mx-auto">
        Mingle has constraints on purpose. Here's why.
      </p>
    </div>
    
    <!-- Rules list -->
    <div class="space-y-6">
      {rules.map((item, index) => (
        <div 
          class="reveal flex items-start gap-5 p-6 rounded-2xl border border-[var(--color-dark-border)] bg-[var(--color-dark-card)]/50 hover:border-[var(--color-primary)]/40 transition-colors"
          style={`transition-delay: ${index * 0.1}s`}
        >
          <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] flex items-center justify-center">
            <Fragment set:html={item.icon} />
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-1">{item.rule}</h3>
            <p class="text-[var(--color-text-muted)] leading-relaxed">{item.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
