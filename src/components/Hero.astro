---
// Hero section - Mingle brand style with photo grid
---

<section class="relative min-h-screen bg-[var(--color-dark)] overflow-hidden flex items-center justify-center pt-20">
  <!-- Photo grid background -->
  <div class="absolute inset-0 grid grid-cols-4 md:grid-cols-6 gap-2 opacity-40 blur-[1px]">
    <!-- Row 1 -->
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    
    <!-- Row 2 -->
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    
    <!-- Row 3 -->
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1488426862026-3ee34a7d66df?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=300&q=80')] bg-cover bg-center"></div>
    </div>
    <div class="aspect-[3/4] bg-gradient-to-br from-purple-900/50 to-gray-900 rounded-lg overflow-hidden hidden md:block">
      <div class="w-full h-full bg-[url('https://images.unsplash.com/photo-1507591064344-4c6ce005b128?w=300&q=80')] bg-cover bg-center"></div>
    </div>
  </div>
  
  <!-- Gradient overlays -->
  <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-dark)] via-transparent to-[var(--color-dark)]"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-dark)] via-transparent to-[var(--color-dark)]"></div>
  <div class="absolute inset-0 bg-[var(--color-dark)]/50"></div>
  
  <!-- Content -->
  <div class="relative z-10 text-center max-w-3xl mx-auto px-6">
    <!-- Logo icon -->
    <div class="flex justify-center mb-8 animate-fade-in-up">
      <div class="logo-icon w-20 h-20 text-3xl animate-pulse-glow">M</div>
    </div>
    
    <!-- Tagline -->
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 tracking-tight animate-fade-in-up" style="animation-delay: 0.1s;">
      Check in. Match.<br/>Go say hi.
    </h1>
    
    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-[var(--color-text-muted)] max-w-lg mx-auto animate-fade-in-up" style="animation-delay: 0.2s;">
      See who's at the same place as you. The rest is up to you.
    </p>
  </div>
  
  <!-- Scroll indicator -->
  <a href="#how-it-works" class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-[var(--color-text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </a>
</section>
