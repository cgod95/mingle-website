---
// App Preview section - iPhone video mockup with app store badges
---

<section id="app-preview" class="py-24 bg-[var(--color-dark)] relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      
      <!-- Left content -->
      <div class="reveal">
        <span class="inline-block px-4 py-2 bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] rounded-full text-sm font-semibold mb-4 border border-[var(--color-primary)]/30">
          See it in action
        </span>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Here's how<br/>
          <span class="text-gradient">it looks</span>
        </h2>
        <p class="text-xl text-[var(--color-text-muted)] mb-8">
          Check in at a venue. See who's around. The rest is up to you.
        </p>
        
        <!-- App store badges -->
        <div class="flex flex-wrap gap-4">
          <a href="#" class="inline-block transition-transform hover:scale-105">
            <svg class="h-[52px]" viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg">
              <rect width="120" height="40" rx="5" fill="#000"/>
              <rect x="0.5" y="0.5" width="119" height="39" rx="4.5" stroke="#A6A6A6" fill="none"/>
              <text x="42" y="15" fill="#fff" font-size="7" font-family="system-ui, sans-serif">Download on the</text>
              <text x="42" y="28" fill="#fff" font-size="13" font-weight="600" font-family="system-ui, sans-serif">App Store</text>
              <g transform="translate(10, 6) scale(0.55)">
                <path d="M24.769 20.3a5.98 5.98 0 0 1 2.849-5.021 6.12 6.12 0 0 0-4.828-2.61c-2.03-.214-4.006 1.215-5.04 1.215-1.054 0-2.64-1.194-4.357-1.16a6.397 6.397 0 0 0-5.393 3.29c-2.328 4.04-.592 9.98 1.64 13.248 1.116 1.6 2.42 3.382 4.136 3.32 1.676-.068 2.3-1.07 4.32-1.07 2.003 0 2.588 1.07 4.334 1.03 1.792-.03 2.92-1.61 3.996-3.224a13.22 13.22 0 0 0 1.824-3.726 5.771 5.771 0 0 1-3.481-5.292zM21.449 10.2a5.884 5.884 0 0 0 1.348-4.22 5.994 5.994 0 0 0-3.878 2.007 5.61 5.61 0 0 0-1.384 4.063 4.96 4.96 0 0 0 3.914-1.85z" fill="#fff"/>
              </g>
            </svg>
          </a>
          <a href="#" class="inline-block transition-transform hover:scale-105">
            <svg class="h-[52px]" viewBox="0 0 135 40" xmlns="http://www.w3.org/2000/svg">
              <rect width="135" height="40" rx="5" fill="#000"/>
              <rect x="0.5" y="0.5" width="134" height="39" rx="4.5" stroke="#A6A6A6" fill="none"/>
              <text x="50" y="14" fill="#fff" font-size="6.5" font-family="system-ui, sans-serif" text-transform="uppercase" letter-spacing="0.5">GET IT ON</text>
              <text x="50" y="28" fill="#fff" font-size="13" font-weight="600" font-family="system-ui, sans-serif">Google Play</text>
              <g transform="translate(10, 5) scale(0.6)">
                <path d="M6.34 1.33l17.36 9.88L6.34 21.1V1.33z" fill="#4285F4"/>
                <path d="M1.25 0.1L17.36 9.88 6.34 1.33 1.25 0.1z" fill="#34A853" opacity="0.8"/>
                <path d="M1.25 22.33L6.34 21.1l11.02-8.55L1.25 22.33z" fill="#EA4335" opacity="0.8"/>
                <path d="M1.25 0.1v22.23l11.02-11.12L1.25 0.1z" fill="#FBBC04" opacity="0.8"/>
              </g>
            </svg>
          </a>
        </div>
        
        <p class="text-sm text-[var(--color-text-subtle)] mt-4">
          Coming soon to iOS and Android.
        </p>
      </div>
      
      <!-- Right content - iPhone mockup with video -->
      <div class="reveal flex justify-center" style="transition-delay: 0.15s">
        <div class="phone-mockup w-[280px] md:w-[300px] animate-float">
          <div class="phone-screen relative">
            <!-- Video element - replace src with actual app demo -->
            <video 
              autoplay 
              muted 
              loop 
              playsinline
              poster="/images/app-preview-poster.jpg"
              class="w-full h-full object-cover"
            >
              <source src="/videos/app-demo.mp4" type="video/mp4" />
              <source src="/videos/app-demo.webm" type="video/webm" />
            </video>
            
            <!-- Fallback placeholder if no video exists -->
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-[var(--color-dark-secondary)] text-center p-6 video-fallback">
              <div class="logo-icon w-14 h-14 text-xl mb-4">M</div>
              <p class="text-white font-semibold text-lg mb-2">App Preview</p>
              <p class="text-[var(--color-text-muted)] text-sm">Drop your screen recording at<br/><code class="text-[var(--color-primary-light)] text-xs">/public/videos/app-demo.mp4</code></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hide fallback placeholder if video loads successfully
  const video = document.querySelector('#app-preview video') as HTMLVideoElement;
  const fallback = document.querySelector('#app-preview .video-fallback') as HTMLElement;
  
  if (video && fallback) {
    video.addEventListener('loadeddata', () => {
      fallback.style.display = 'none';
    });
    
    video.addEventListener('error', () => {
      video.style.display = 'none';
    });
  }
</script>
