---
// Footer component - Mingle brand style
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-dark)] border-t border-[var(--color-dark-border)] py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      
      <!-- Brand column -->
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="logo-icon w-10 h-10">M</div>
          <span class="text-xl font-bold text-white">Mingle</span>
        </a>
        <p class="text-[var(--color-text-muted)] max-w-sm mb-6">
          No more swiping. No more noise. Just meet people. Real venues, real connections.
        </p>
        
        <!-- Social links -->
        <div class="flex gap-4">
          <a href="#" class="w-10 h-10 rounded-xl bg-[var(--color-dark-card)] border border-[var(--color-dark-border)] flex items-center justify-center hover:bg-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-text-muted)] group-hover:text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-xl bg-[var(--color-dark-card)] border border-[var(--color-dark-border)] flex items-center justify-center hover:bg-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a href="#" class="w-10 h-10 rounded-xl bg-[var(--color-dark-card)] border border-[var(--color-dark-border)] flex items-center justify-center hover:bg-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
            </svg>
          </a>
        </div>
        
        <!-- App store badges -->
        <div class="flex gap-3 mt-6">
          <a href="#" class="inline-block transition-transform hover:scale-105">
            <svg class="h-10" viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg">
              <rect width="120" height="40" rx="5" fill="#000"/>
              <rect x="0.5" y="0.5" width="119" height="39" rx="4.5" stroke="#A6A6A6" fill="none"/>
              <text x="42" y="15" fill="#fff" font-size="7" font-family="system-ui, sans-serif">Download on the</text>
              <text x="42" y="28" fill="#fff" font-size="13" font-weight="600" font-family="system-ui, sans-serif">App Store</text>
              <g transform="translate(10, 6) scale(0.55)">
                <path d="M24.769 20.3a5.98 5.98 0 0 1 2.849-5.021 6.12 6.12 0 0 0-4.828-2.61c-2.03-.214-4.006 1.215-5.04 1.215-1.054 0-2.64-1.194-4.357-1.16a6.397 6.397 0 0 0-5.393 3.29c-2.328 4.04-.592 9.98 1.64 13.248 1.116 1.6 2.42 3.382 4.136 3.32 1.676-.068 2.3-1.07 4.32-1.07 2.003 0 2.588 1.07 4.334 1.03 1.792-.03 2.92-1.61 3.996-3.224a13.22 13.22 0 0 0 1.824-3.726 5.771 5.771 0 0 1-3.481-5.292zM21.449 10.2a5.884 5.884 0 0 0 1.348-4.22 5.994 5.994 0 0 0-3.878 2.007 5.61 5.61 0 0 0-1.384 4.063 4.96 4.96 0 0 0 3.914-1.85z" fill="#fff"/>
              </g>
            </svg>
          </a>
          <a href="#" class="inline-block transition-transform hover:scale-105">
            <svg class="h-10" viewBox="0 0 135 40" xmlns="http://www.w3.org/2000/svg">
              <rect width="135" height="40" rx="5" fill="#000"/>
              <rect x="0.5" y="0.5" width="134" height="39" rx="4.5" stroke="#A6A6A6" fill="none"/>
              <text x="50" y="14" fill="#fff" font-size="6.5" font-family="system-ui, sans-serif" text-transform="uppercase" letter-spacing="0.5">GET IT ON</text>
              <text x="50" y="28" fill="#fff" font-size="13" font-weight="600" font-family="system-ui, sans-serif">Google Play</text>
              <g transform="translate(10, 5) scale(0.6)">
                <path d="M6.34 1.33l17.36 9.88L6.34 21.1V1.33z" fill="#4285F4"/>
                <path d="M1.25 0.1L17.36 9.88 6.34 1.33 1.25 0.1z" fill="#34A853" opacity="0.8"/>
                <path d="M1.25 22.33L6.34 21.1l11.02-8.55L1.25 22.33z" fill="#EA4335" opacity="0.8"/>
                <path d="M1.25 0.1v22.23l11.02-11.12L1.25 0.1z" fill="#FBBC04" opacity="0.8"/>
              </g>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Links columns -->
      <div>
        <h4 class="font-bold text-white mb-4">Product</h4>
        <ul class="space-y-3">
          <li><a href="#how-it-works" class="text-[var(--color-text-muted)] hover:text-white transition-colors">How it works</a></li>
          <li><a href="#features" class="text-[var(--color-text-muted)] hover:text-white transition-colors">Features</a></li>
          <li><a href="#safety" class="text-[var(--color-text-muted)] hover:text-white transition-colors">Safety</a></li>
          <li><a href="#faq" class="text-[var(--color-text-muted)] hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-bold text-white mb-4">Legal</h4>
        <ul class="space-y-3">
          <li><a href="/privacy" class="text-[var(--color-text-muted)] hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-[var(--color-text-muted)] hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="text-[var(--color-text-muted)] hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    
    <!-- Bottom bar -->
    <div class="pt-8 border-t border-[var(--color-dark-border)] flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-[var(--color-text-subtle)] text-sm">
        © {currentYear} Mingle. All rights reserved.
      </p>
      <p class="text-[var(--color-text-subtle)] text-sm">
        Made with 💜 in Sydney, Australia
      </p>
    </div>
  </div>
</footer>
