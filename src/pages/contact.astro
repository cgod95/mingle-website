---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact - Mingle" description="Get in touch with the Mingle team. We'd love to hear from you.">
  <Header />
  
  <main class="pt-24 pb-16 bg-[var(--color-dark)]">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-2 bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] rounded-full text-sm font-semibold mb-4 border border-[var(--color-primary)]/30">
          Contact
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Get in Touch</h1>
        <p class="text-xl text-[var(--color-text-muted)]">
          Have questions, feedback, or just want to say hi? We'd love to hear from you.
        </p>
      </div>
      
      <!-- Contact Cards -->
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        
        <!-- General Inquiries -->
        <div class="card-gradient p-8 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">General Inquiries</h3>
          <p class="text-[var(--color-text-muted)] mb-4">Questions about Mingle or partnership opportunities</p>
          <a href="mailto:hello@getmingle.app" class="text-[var(--color-primary-light)] hover:underline font-medium">
            hello@getmingle.app
          </a>
        </div>
        
        <!-- Support -->
        <div class="card-gradient p-8 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Support</h3>
          <p class="text-[var(--color-text-muted)] mb-4">Need help with your account or the app?</p>
          <a href="mailto:support@getmingle.app" class="text-[var(--color-primary-light)] hover:underline font-medium">
            support@getmingle.app
          </a>
        </div>
        
        <!-- Venues -->
        <div class="card-gradient p-8 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Venue Partners</h3>
          <p class="text-[var(--color-text-muted)] mb-4">Want your venue on Mingle?</p>
          <a href="mailto:venues@getmingle.app" class="text-[var(--color-primary-light)] hover:underline font-medium">
            venues@getmingle.app
          </a>
        </div>
        
        <!-- Press -->
        <div class="card-gradient p-8 text-center">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Press & Media</h3>
          <p class="text-[var(--color-text-muted)] mb-4">Media inquiries and press requests</p>
          <a href="mailto:press@getmingle.app" class="text-[var(--color-primary-light)] hover:underline font-medium">
            press@getmingle.app
          </a>
        </div>
        
      </div>
      
      <!-- Location -->
      <div class="card-gradient p-8 text-center">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[var(--color-primary)]/20 text-[var(--color-primary-light)] mb-6 mx-auto">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Based in Sydney</h3>
        <p class="text-[var(--color-text-muted)]">
          Mingle is proudly built in Sydney, Australia 🇦🇺
        </p>
      </div>
      
      <!-- Social Links -->
      <div class="mt-12 text-center">
        <h3 class="text-lg font-semibold text-white mb-4">Follow Us</h3>
        <div class="flex justify-center gap-4">
          <a href="#" class="w-12 h-12 rounded-xl bg-[var(--color-dark-card)] border border-[var(--color-dark-border)] flex items-center justify-center hover:bg-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="#" class="w-12 h-12 rounded-xl bg-[var(--color-dark-card)] border border-[var(--color-dark-border)] flex items-center justify-center hover:bg-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          <a href="#" class="w-12 h-12 rounded-xl bg-[var(--color-dark-card)] border border-[var(--color-dark-border)] flex items-center justify-center hover:bg-[var(--color-primary)] hover:border-[var(--color-primary)] transition-colors">
            <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <div class="mt-12 pt-8 border-t border-[var(--color-dark-border)]">
        <a href="/" class="inline-flex items-center gap-2 text-[var(--color-primary-light)] hover:underline">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

